{
  "name": "cryptovision",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @cv/web dev",
    "build": "pnpm --filter @cv/web build",
    "start": "pnpm --filter @cv/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @cv/web typecheck",
    "backtest": "tsx scripts/backtest-cli.ts",
    "validate:oos": "tsx scripts/validate-oos.ts"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.10.0",
    "technicalindicators": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@cv/backtest": "workspace:*",
    "@cv/core": "workspace:*",
    "@cv/signals": "workspace:*"
  }
}
