{
  "name": "cryptovision",
  "private": true,
  "version": "1.2.0",
  "description": "Platform\u00eb analize p\u00ebr kriptovalutat: CV Rating, rekomandime, sinjale, backtest, grafik me vizatime dhe menaxhim rreziku",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edon-bublaku/CryptoVision-Pro.git"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @cv/web dev",
    "build": "pnpm --filter @cv/web build",
    "start": "pnpm --filter @cv/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @cv/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "backtest": "tsx scripts/backtest-cli.ts",
    "validate:oos": "tsx scripts/validate-oos.ts",
    "db:migrate": "pnpm --filter @cv/db migrate",
    "db:generate": "pnpm --filter @cv/db generate",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://cryptovision@localhost:5432/cryptovision_test} vitest run",
    "test:e2e": "playwright test",
    "worker": "pnpm --filter @cv/worker start",
    "validate:rating": "tsx scripts/validate-rating.ts",
    "dev:clean": "rm -rf apps/web/.next/dev && pnpm dev",
    "recommend": "tsx scripts/recommend-now.ts",
    "mock:binance": "tsx scripts/mock-binance.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cv/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "technicalindicators": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@cv/backtest": "workspace:*",
    "@cv/core": "workspace:*",
    "@cv/exchange": "workspace:*",
    "@cv/rating": "workspace:*",
    "@cv/signals": "workspace:*"
  }
}
