# ── Core ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Nothing here is required: `pnpm dev` runs the full platform out of the box.
#
# Data home (embedded database + generated secret key). Default ~/.cryptovision
# CV_HOME=
# Database. Unset → embedded PostgreSQL (PGlite) stored in $CV_HOME/db (or PGLITE_DIR).
# Set a postgres:// URL for an external PostgreSQL (TimescaleDB optional), or `off` for local-only mode.
# DATABASE_URL=postgres://user:pass@localhost:5432/cryptovision
# PGLITE_DIR=
# Redis is only needed to run several server instances or a separate worker process.
# REDIS_URL=redis://localhost:6379
# Worker: inprocess (default, runs inside the web server) | external (`pnpm worker`, needs PostgreSQL) | off
# WORKER=inprocess
# 32 random bytes, hex or base64: `openssl rand -hex 32`. Optional: when unset, a random key is
# generated once in $CV_HOME/secret.key. Required in production with an external PostgreSQL.
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# ── AI explanations (optional) ───────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Notifications (optional) ─────────────────────────────────────────
# Platform bot used by the worker; users only enter their chat id.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="CryptoVision Pro <alerts@example.com>"
# `pnpm --filter @cv/worker vapid` prints a key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Trading on Binance (ADR 0012) ────────────────────────────────────
# on: testnet + live (live must still be enabled per user with password + 2FA) | testnet | off
TRADING=on
# Optional testnet host overrides (live hosts are fixed in code).
# BINANCE_TESTNET_SPOT_URL=https://testnet.binance.vision
# BINANCE_TESTNET_FUTURES_URL=https://testnet.binancefuture.com

# ── Worker ───────────────────────────────────────────────────────────
SCAN_TIMEFRAMES=1h,4h,1d
SCAN_SIZE=60
LOG_LEVEL=info
