# ── Core ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Without DATABASE_URL the app runs in local-only mode (browser storage).
DATABASE_URL=postgres://cryptovision:cryptovision@localhost:5432/cryptovision
REDIS_URL=redis://localhost:6379
# 32 random bytes, hex or base64: `openssl rand -hex 32`. Required in production.
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# ── AI explanations (optional) ───────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Notifications (optional) ─────────────────────────────────────────
# Platform bot used by the worker; users only enter their chat id.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="CryptoVision Pro <alerts@example.com>"
# `pnpm --filter @cv/worker vapid` prints a key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Worker ───────────────────────────────────────────────────────────
SCAN_TIMEFRAMES=1h,4h,1d
SCAN_SIZE=60
LOG_LEVEL=info
